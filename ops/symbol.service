[Unit]
Description=symbol static site hosting
After=network-online.target
Wants=network-online.target

[Service]
User=samuel
Group=samuel
WorkingDirectory=/home/samuel/symbol
ExecStart=/home/samuel/symbol/target/release/symbol --bind 127.0.0.1:4340 --root /var/lib/symbol
Restart=on-failure
StateDirectory=symbol
Environment=RUST_LOG=info,symbol::mutation=info
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=0
Environment=SYMBOL_BIND=127.0.0.1:4340
Environment=SYMBOL_ROOT=/var/lib/symbol
Environment=SYMBOL_PUBLIC_URL=http://symbol
Environment=SYMBOL_MAX_FILE_SIZE=4294967296
Environment=SYMBOL_MAX_ARCHIVE_UPLOAD=52428800
Environment=SYMBOL_MAX_ARCHIVE_EXTRACTED=83886080
Environment=SYMBOL_MAX_ARCHIVE_FILES=5000
Environment=SYMBOL_EXPIRY_MIN_AGE=30d
Environment=SYMBOL_EXPIRY_MAX_AGE=365d
Environment=SYMBOL_EXPIRY_MAX_SIZE=512MiB
Environment=SYMBOL_EXPIRY_POWER=3
Environment=SYMBOL_AUDIT_TRUSTED_PROXY=127.0.0.1
# Choose at most one authenticated creator identity header and trust only the
# reverse-proxy peer IPs that overwrite it:
# Environment=SYMBOL_TRUSTED_PROXY=127.0.0.1
# Environment=SYMBOL_TRUSTED_PROXY_PRINCIPAL_HEADER=X-Authenticated-User
# Environment=SYMBOL_MTLS_PRINCIPAL_HEADER=X-Client-Cert-SHA256
# Environment=SYMBOL_TAILSCALE_USER_HEADER=Tailscale-User-Login
# Environment=SYMBOL_TAILSCALE_WHOIS_COMMAND=/usr/bin/tailscale

[Install]
WantedBy=multi-user.target
