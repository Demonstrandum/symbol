#!/bin/sh
set -eu

cd "$(dirname "$0")"

if [ "${SYMBOL_DEPLOY_CHECK:-0}" = 1 ] &&
  [ "${SYMBOL_PRODUCTION_PHASE:-}" != 10 ]; then
  printf 'production access is restricted to Phase 10\n' >&2
  exit 64
fi

./check
cargo build --workspace --release --locked
sh nix/check.sh --cores "${NIX_CORES:-8}" --max-jobs "${NIX_MAX_JOBS:-4}"

if [ -n "${SYMBOL_SOAK_SECONDS:-}" ]; then
  sh tests/concurrency_soak.sh
fi

if [ "${SYMBOL_DEPLOY_CHECK:-0}" = 1 ]; then
  ./ops/restart.sh
fi

printf 'release gate passed\n'
