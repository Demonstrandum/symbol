#!/bin/sh
set -eu

SYMBOL_GENERATION_MODE='readonly'
export SYMBOL_GENERATION_MODE

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
cargo test --workspace --all-targets --all-features --locked
cargo build --workspace --locked
sh -n static/symbol.sh
sh -n tests/symbol_client.sh
sh -n tests/alias_transfer_e2e.sh
sh -n tests/lifecycle_e2e.sh
sh -n tests/production_guard.sh
sh tests/production_guard.sh
python3 tests/public_api_freeze.py
python3 tests/api_contract.py
python3 tests/command_matrix.py
tests/symbol_client.sh
sh tests/alias_transfer_e2e.sh
sh tests/lifecycle_e2e.sh
